        </mxCell>
        <mxCell id="off_queue" value="&lt;b&gt;job_queue&lt;/b&gt;：序列化所有工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="off">
          <mxGeometry x="10" y="98" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="off_svc" value="&lt;b&gt;services&lt;/b&gt;：index・search・category&lt;br&gt;image（只收 data URL）・history_import・status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="off">
