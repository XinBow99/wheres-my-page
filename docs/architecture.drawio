        </mxCell>

        <mxCell id="st_local" value="chrome.storage.local&lt;br&gt;settings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="260" height="66" as="geometry" />
        </mxCell>
        <mxCell id="st_idb" value="&lt;b&gt;IndexedDB&lt;/b&gt;&lt;br&gt;semhist（文字）&lt;br&gt;semhist-img（圖片）&lt;br&gt;名稱與 schema 不變" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
