        </mxCell>
        <mxCell id="sw_sync" value="&lt;b&gt;settings_sync&lt;/b&gt;&lt;br&gt;設定變更時推送&lt;br&gt;settings.sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw">
          <mxGeometry x="175" y="162" width="155" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sw_feat" value="&lt;b&gt;commands&lt;/b&gt;（4 組快捷鍵）・&lt;b&gt;context_menus&lt;/b&gt;&lt;br&gt;&lt;b&gt;omnibox&lt;/b&gt;（ss）・&lt;b&gt;side_panel&lt;/b&gt;.open()&lt;br&gt;&lt;b&gt;history&lt;/b&gt;（chrome.history 匯入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sw">
          <mxGeometry x="10" y="232" width="320" height="62" as="geometry" />
        </mxCell>
        <mxCell id="sw_cap" value="&lt;b&gt;captureVisibleTab&lt;/b&gt;（圖片截圖退路）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw">
          <mxGeometry x="10" y="304" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sw_note" value="跨環境訊息：JSON 可序列化・Result&amp;lt;T&amp;gt;／ErrorCode・timeout・只重試 retryable" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="sw">
          <mxGeometry x="10" y="348" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="off" value="Offscreen Document（src/offscreen/）&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:11px&quot;&gt;只能用 chrome.runtime・一個擴充功能只有一個・無存活時限&lt;/font&gt;" style="swimlane;startSize=44;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
