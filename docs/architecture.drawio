<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="runtime" name="1. 執行環境與訊息流">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Where&#39;s My Page? — 執行環境架構（Chrome MV3）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;所有推論與資料都在本機；唯一的網路請求是下載模型權重&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="44" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="擴充功能頁面（src/ui/）・可用全部 chrome.*" style="swimlane;startSize=30;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ui_sp" value="&lt;b&gt;Side Panel&lt;/b&gt;&lt;br&gt;sidepanel/&lt;br&gt;窄版搜尋" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ui">
          <mxGeometry x="10" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ui_popup" value="&lt;b&gt;Popup&lt;/b&gt;&lt;br&gt;popup/&lt;br&gt;狀態＋快速動作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ui">
          <mxGeometry x="120" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ui_search" value="&lt;b&gt;完整搜尋頁&lt;/b&gt;&lt;br&gt;search/&lt;br&gt;寬版・設定・分類" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ui">
          <mxGeometry x="230" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ui_app" value="search_app ＋ components（h()、status_banner aria-live、design tokens）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecf6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ui">
          <mxGeometry x="10" y="112" width="320" height="44" as="geometry" />
        </mxCell>

        <mxCell id="cs" value="Content Script（每個分頁・isolated world・IIFE bundle）&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;⚠ 不受信任：訊息一律驗證，不可觸發破壞性操作或任意 URL 請求&lt;/font&gt;" style="swimlane;startSize=44;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontStyle=1;" vertex="1" parent="1">
