          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sw_local" value="settings_store（get／update／onChange）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1" source="sw" target="st_local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_off_idb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#d6b656;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="off" target="st_idb">
