        </mxCell>
        <mxCell id="off_store" value="&lt;b&gt;storage/&lt;/b&gt;&lt;br&gt;vector_index：記憶體 Float32 矩陣、chunk max-pool cosine＋關鍵字＋近期&lt;br&gt;db.ts：schema v2、遷移、meta（取代 localStorage）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;fontSize=11;" vertex="1" parent="off">
