        </mxCell>
        <mxCell id="m_bg" value="&lt;b&gt;background/&lt;/b&gt;&lt;br&gt;Service Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_off" value="&lt;b&gt;offscreen/&lt;/b&gt;&lt;br&gt;模型宿主" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="80" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_mp" value="@mediapipe/tasks-retrieval&lt;br&gt;1.2.3（npm）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_storage" value="&lt;b&gt;storage/&lt;/b&gt;&lt;br&gt;IndexedDB 資料層" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ea;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="200" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_core" value="&lt;b&gt;core/&lt;/b&gt; — 純演算法（無 chrome／DOM／indexedDB／fetch，可在 Node 測試）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_shared" value="&lt;b&gt;shared/&lt;/b&gt; — 契約、型別、常數、設定；只能 import shared 自己" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_note" value="所有模組都可以 import shared/（為了清楚起見，圖中省略這些箭頭）。" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
