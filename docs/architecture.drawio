  <diagram id="modules" name="2. 模組依賴規則">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="m_title" value="&lt;b&gt;模組依賴規則（dependency-cruiser 強制）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;箭頭＝「可以 import」。未畫出的方向一律禁止；不得循環依賴。&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="760" height="44" as="geometry" />
        </mxCell>

        <mxCell id="m_ui" value="&lt;b&gt;ui/&lt;/b&gt;&lt;br&gt;Side Panel・Popup・搜尋頁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_content" value="&lt;b&gt;content/&lt;/b&gt;&lt;br&gt;Content Script" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
