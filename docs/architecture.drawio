        </mxCell>
        <mxCell id="off_emb" value="&lt;b&gt;embedder&lt;/b&gt;&lt;br&gt;MediaPipe UniversalEmbedder&lt;br&gt;WebGPU・EmbeddingGemma-2&lt;br&gt;縮短重試（512 token）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="off">
          <mxGeometry x="10" y="202" width="165" height="76" as="geometry" />
        </mxCell>
        <mxCell id="off_cache" value="&lt;b&gt;model_cache&lt;/b&gt;&lt;br&gt;streaming 下載&lt;br&gt;進度 → Port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="off">
