          <mxGeometry x="10" y="54" width="310" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cs_dwell" value="&lt;b&gt;dwell_controller&lt;/b&gt;：停留計時、SPA 換頁&lt;br&gt;← core/dwell 狀態機（純函式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cs">
          <mxGeometry x="10" y="98" width="310" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cs_extract" value="&lt;b&gt;extractor&lt;/b&gt;：article/main 文字擷取、顯示中的密碼欄位偵測" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cs">
          <mxGeometry x="10" y="154" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cs_badge" value="&lt;b&gt;badge&lt;/b&gt;：shadow DOM 狀態圓點、鍵盤可操作選單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cs">
          <mxGeometry x="10" y="204" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cs_picker" value="&lt;b&gt;picker / hints&lt;/b&gt;：區塊片段、text fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cs">
          <mxGeometry x="10" y="254" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cs_img" value="&lt;b&gt;image_capture / auto_images&lt;/b&gt;（D6）&lt;br&gt;在頁面 context 抓原圖 → data URL（≤ 8 MB）&lt;br&gt;抓不到 → 請 SW 截圖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cs">
          <mxGeometry x="10" y="304" width="310" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sw" value="Service Worker（src/background/）&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:11px&quot;&gt;閒置 30 秒終止・listener 頂層同步註冊・不依賴全域狀態&lt;/font&gt;" style="swimlane;startSize=44;rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="340" height="410" as="geometry" />
        </mxCell>
        <mxCell id="sw_main" value="main.ts（所有 listener 在頂層註冊）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw">
          <mxGeometry x="10" y="54" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sw_router" value="&lt;b&gt;router&lt;/b&gt;：validate → sender.id → 來源分級 → policy&lt;br&gt;排除清單・無痕・破壞性操作只限 extension page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sw">
          <mxGeometry x="10" y="98" width="320" height="54" as="geometry" />
        </mxCell>
        <mxCell id="sw_host" value="&lt;b&gt;offscreen_host&lt;/b&gt;&lt;br&gt;getContexts／createDocument&lt;br&gt;reason: WORKERS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw">
